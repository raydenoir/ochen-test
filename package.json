{
  "name": "smysl-illustration-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/check-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node server/start.mjs",
    "test": "npm run test:unit && npm run test:ui",
    "test:unit": "node --test tests/studio.test.cjs tests/semantic.test.mjs tests/jev.test.mjs tests/layout.test.mjs",
    "test:ui": "vitest run",
    "examples": "node scripts/export-examples.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "lucide-react": "^0.577.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "happy-dom": "21.0.4",
    "postcss": "8.5.32",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "5.1.0"
  }
}
